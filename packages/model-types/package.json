{
	"name": "@earendil-works/rozsa-model-types",
	"version": "0.75.5",
	"description": "Shared type definitions for AI model protocols",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
