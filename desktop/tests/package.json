{
  "name": "rozsa-desktop-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:ui && npm run test:process && npm run test:vitest && tsx --test --test-concurrency=1 input-bridge.test.ts",
    "test:ui": "tsx --test --test-concurrency=1 shared-ui-source.test.js",
    "test:process": "tsx --test --test-concurrency=1 debug-sessions.test.js session-list.test.ts session-history.test.ts session-contract.test.ts bridge.test.ts lifecycle.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:performance": "node --test --test-concurrency=1 performance/*.test.js",
    "test:performance:calibrate": "ROZSA_PERF_CALIBRATION=1 ROZSA_PERF_ROUNDS=30 node --test --test-concurrency=1 performance/*.test.js",
    "test:sessions": "tsx run-session-tests.ts",
    "test:native": "tsx native-session-list.test.ts",
    "test:native-lifecycle": "tsx --test --test-concurrency=1 approval-question-lifecycle.native.test.js",
    "test:session-list": "tsx session-list.test.ts",
    "test:session-history": "tsx session-history.test.ts",
    "test:session-contract": "tsx session-contract.test.ts",
    "test:native-history": "tsx native-session-history.test.ts",
    "test:resources": "tsx --test --test-concurrency=1 build-resources.test.ts project-independence.test.js ts-resource-loading.test.js",
    "test:native-resources": "tsx --test --test-concurrency=1 native-forge.test.ts package-resources.test.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "jsdom": "27.1.0",
    "tsx": "4.20.6",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
