{
  "name": "rozsa-desktop",
  "productName": "Rózsa",
  "version": "0.0.0",
  "description": "Rózsa desktop application",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "format": "cd .. && oxfmt --write --ignore-path .gitignore \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "format:check": "cd .. && oxfmt --check --ignore-path .gitignore \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "typecheck": "node scripts/typecheck.mjs",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:resources": "npm --prefix tests run test:resources",
    "start": "electron-forge start"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "oxfmt": "0.74.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@streamdown/code": "^2.0.0",
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "1.59.0",
    "pele": "1.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "vscode-jsonrpc": "9.0.3"
  }
}
